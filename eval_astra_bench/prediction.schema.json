{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One trajectory per JSONL line",
  "type": "object",
  "required": ["schema_version", "benchmark_id", "trajectory_id", "frame_indices", "progress"],
  "properties": {
    "schema_version": {"const": "astra_progress_predictions/v1"},
    "benchmark_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trajectory_id": {"type": "string", "minLength": 1},
    "frame_indices": {"type": "array", "minItems": 32, "maxItems": 32, "uniqueItems": true,
                      "items": {"type": "integer", "minimum": 0, "maximum": 31}},
    "progress": {"type": "array", "minItems": 32, "maxItems": 32,
                 "items": {"type": "number", "minimum": 0, "maximum": 1}}
  }
}
